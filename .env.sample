# --- LLM provider: ollama | gemini | openai | openai_compatible ---
LLM_PROVIDER=ollama

# Model name. Optional for ollama / gemini / openai (defaults: llama3.1 / gemini-2.5-flash / gpt-4o-mini).
# Required for openai_compatible.
LLM_MODEL=

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434

# Gemini
GOOGLE_API_KEY=

# OpenAI
OPENAI_API_KEY=

# OpenAI-compatible endpoint (e.g. OpenRouter, vLLM, LM Studio)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# MCP server port, and the endpoint the agent connects to (keep the ports in sync)
MCP_PORT=8000
MCP_URL=http://127.0.0.1:8000/mcp

# AgentDNA
AGENTDNA_API_KEY=

AGENTDNA_USER=
AGENTDNA_AGENT=
AGENTDNA_MCP_SERVER_NAME=


# AgentDNA environment: dev or test-prod (default). Selects the provenance
# layer, admin server and dashboard (see wizard/environments.py). The installer
# and the wizard set it.
AGENTDNA_ENV=dev

# Optional: override a single service URL of the environment.
# AGENTDNA_PROVENANCE_URL=
# AGENTDNA_ADMIN_SERVER_URL=

