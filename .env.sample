# --- LLM provider: ollama | gemini | openai ---
LLM_PROVIDER=gemini

# Optional model override. Defaults: llama3.1 (ollama) / gemini-2.5-flash (gemini) / gpt-4o-mini (openai)
LLM_MODEL=

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434

# Gemini
GOOGLE_API_KEY=

# OpenAI
OPENAI_API_KEY=

# MCP server endpoint (must match mcp_server.py host/port)
MCP_URL=http://127.0.0.1:8000/mcp
